# Copy this file to .env before running the stack:
#   cp .env.example .env
#
# Every value below is a placeholder or a safe local default. Never commit .env.

# ---------------------------------------------------------------------------
# Backend (pydantic-settings reads the MISSION_AUTOPSY_ prefix)
# ---------------------------------------------------------------------------
MISSION_AUTOPSY_ENVIRONMENT=development
MISSION_AUTOPSY_API_HOST=127.0.0.1
MISSION_AUTOPSY_API_PORT=8000
MISSION_AUTOPSY_LOG_LEVEL=INFO
MISSION_AUTOPSY_DATABASE_PATH=./data/mission_autopsy.db
MISSION_AUTOPSY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vite exposes only VITE_* variables to the browser)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_DOCS_URL=http://127.0.0.1:8000/docs

# ---------------------------------------------------------------------------
# Reserved for the agent layer; not read by the scaffold yet
# ---------------------------------------------------------------------------
MISSION_AUTOPSY_LLM_PROVIDER=your-provider
MISSION_AUTOPSY_LLM_MODEL=your-model
MISSION_AUTOPSY_LLM_API_KEY=your-api-key
