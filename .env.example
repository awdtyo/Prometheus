# Copy to .env and fill in. .env is gitignored; never commit real values.
GROQ_API_KEY=your-groq-api-key

# Main model: Proposer and Skeptic.
GROQ_MODEL=your-main-groq-model
# Fast model: Prosecutor and Judge rationale. Falls back to GROQ_MODEL when unset.
GROQ_MODEL_FAST=your-fast-groq-model

# Optional overrides.
# PROMETHEUS_DATA_DIR=data
# PROMETHEUS_CACHE_DIR=data/cache
# GROQ_TPM_LIMIT=6000
# Set to empty to omit the parameter for models that do not support it.
# GROQ_REASONING_EFFORT=low
